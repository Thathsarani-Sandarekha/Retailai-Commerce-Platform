{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlySpecificApplicationSecrets",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": [
        "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT_ID:secret:retailai/database-url-*",
        "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT_ID:secret:retailai/groq-api-key-*"
      ]
    }
  ]
}
