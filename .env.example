# LOCAL SYNTHETIC DEMO ONLY — keep .env private and out of Git
DATABASE_URL=sqlite:///./retailai_demo.db
# Choose an available tool-calling Groq model for your tier.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Groq Vision model (configure supported model in your Groq account if using Style Rescue)
# GROQ_VISION_MODEL=

# Shopify integration: local is the safe default
SHOPIFY_ADAPTER=local
# For opt-in Shopify development-store reads only:
# SHOPIFY_ADAPTER=shopify
# SHOPIFY_TENANT_ID=northstar
# SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
# SHOPIFY_ADMIN_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2026-10

# Private catalog photo storage. Local is default and requires no AWS account.
RETAILAI_STORAGE_BACKEND=local
RETAILAI_STORAGE_LOCAL_DIR=.retailai_storage
# For opt-in private Amazon S3 storage with an IAM role or AWS CLI profile:
# RETAILAI_STORAGE_BACKEND=s3
# RETAILAI_S3_BUCKET=your-private-catalog-bucket
# RETAILAI_S3_PREFIX=retailai
# AWS_DEFAULT_REGION=us-east-1

# Database bootstrap:
# SQLite demo: automatic table creation + demo seeding (default).
# PostgreSQL: run alembic upgrade head; demo seeding off by default.
# RETAILAI_SEED_DEMO_DATA=0

# Privacy-safe, structured AI logs (timings, tool status and available token counts).
# No customer content, images, tool arguments, API keys, or IDs are logged.
RETAILAI_AI_OBSERVABILITY=1
